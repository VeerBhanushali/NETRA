# =====================================================================
#  NETRA configuration. Copy to .env and edit.
#      cp .env.example .env
#  .env is gitignored. Never commit real keys.
# =====================================================================

# --- [1] API ---------------------------------------------------------
NETRA_API_HOST=127.0.0.1
NETRA_API_PORT=8000
# Shared secret the edge workers sign ingest with. CHANGE THIS before
# the API is reachable from anything but localhost.
NETRA_INGEST_TOKEN=dev-ingest-token
NETRA_CORS=http://localhost:3000,http://127.0.0.1:3000

# --- [2] Storage -----------------------------------------------------
# SQLite path. In Docker this is a mounted volume so data survives
# redeploys. Leave unset to use ./data/netra.db.
# NETRA_DB=/data/netra.db
# NETRA_EVIDENCE_DIR=/data/evidence

# --- [3] Accuracy policy ---------------------------------------------
# At or above this voted confidence, a plate is published as fact.
NETRA_AUTO_ACCEPT=0.90
# Between this and auto-accept, a human decides. Below it, discarded.
NETRA_REVIEW_MIN=0.55

# --- [4] Rules engine ------------------------------------------------
# Road distance / straight-line distance in a city. Raising it makes the
# cloned-plate rule more conservative.
NETRA_CIRCUITY=1.35
# Implied speed above which a single vehicle cannot have made the trip.
NETRA_CLONE_SPEED=150
NETRA_SPEED_LIMIT=60
NETRA_LOITER_WINDOW=30
NETRA_LOITER_COUNT=5
NETRA_LOITER_DWELL=480

# --- [5] Edge worker -------------------------------------------------
NETRA_API_URL=http://127.0.0.1:8000
NETRA_EDGE_FPS=12
# Model weights. Leave the plate model empty to run a crude smoke test.
# NETRA_VEHICLE_MODEL=yolov8n.pt
# NETRA_PLATE_MODEL=models/onnx/plate_yolov8n.pt

# --- [6] Cloud AI arbitration (optional) -----------------------------
# Off by default: everything works locally without it.
NETRA_AI_ENABLED=false
NETRA_AI_PROVIDER=stub          # stub | gemini | openai | anthropic | grok
NETRA_AI_API_KEY=
NETRA_AI_MODEL=
# Hard daily ceiling. On breach the system degrades to local-only.
NETRA_AI_BUDGET=2.00
# Serve only from cache — flip this on if venue wifi dies mid-demo.
NETRA_AI_CACHE_ONLY=false

# --- [7] Web ---------------------------------------------------------
# Server-side only. Must never be prefixed NEXT_PUBLIC_.
# NETRA_API_URL=http://api:8000

# --- [9] Vehicle registration lookup ---------------------------------
# Owner / RC / PUC / insurance. Default 'mock' returns SYNTHETIC records
# that are clearly labelled as demo data in the API and the UI.
#
# For real VAHAN-derived data, sign up with a licensed RC-verification
# provider, set these, then verify with:
#     python scripts/check_rc_api.py KL07BA5252
#
# Do NOT point this at parivahan.gov.in — it is CAPTCHA/OTP gated on
# purpose and scraping it is both a terms violation and the exact abuse
# this system's privacy design exists to prevent.
NETRA_RC_PROVIDER=mock
# NETRA_RC_URL=https://<provider>/api/v1/rc/rc-full
# NETRA_RC_KEY=
# NETRA_RC_FIELD=id_number
# NETRA_RC_ENVELOPE=data
# NETRA_RC_AUTH_HEADER=authorization
# NETRA_RC_AUTH_FORMAT=Bearer {key}
# How long a fetched owner record is held in memory. Never written to disk.
NETRA_RC_CACHE_TTL=300
